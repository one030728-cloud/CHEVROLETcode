PORT=3000

# 배포 플랫폼의 로드밸런서/프록시 홉 수. Render, GCP Cloud Run/App Engine 등 대부분의 PaaS는
# 1홉(로드밸런서 1개)이라 기본값 1이면 충분하다. express-rate-limit이 개별 클라이언트 IP를
# 올바르게 구분하려면 이 값이 실제 프록시 구성과 맞아야 한다(안 맞으면 레이트리밋이 전체
# 트래픽에 뭉뚱그려 적용됨). 로컬 개발(프록시 없음)에서는 0으로 바꿔도 되지만 안 바꿔도 무방하다.
TRUST_PROXY_HOPS=1

# DB. Cloud SQL for PostgreSQL 연결 문자열.
# 로컬 개발 시 postgres 컨테이너(docker run -e POSTGRES_PASSWORD=devpass -e POSTGRES_DB=devdb -p 5432:5432 postgres:16-alpine)
# 등으로 대체 가능. GCP 배포 시 Cloud SQL 연결 문자열로 교체 (docs/gcp-migration-and-scale-plan.md 참고).
DATABASE_URL="postgresql://postgres:devpass@localhost:5432/devdb?schema=public"

# 솔라피 (알림톡)
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=
SOLAPI_KAKAO_PFID=

# 예약 접수 시 대기번호+남은 인원 안내 (대기중인 손님이 있을 때만 발송. 없으면 바로 순서 호출 템플릿이 나감)
SOLAPI_KAKAO_TEMPLATE_RESERVATION=
# 매장에서 순서를 호출할 때 "고객님의 순서입니다" 안내
SOLAPI_KAKAO_TEMPLATE_QUEUE_TURN=
# 결제 완료 전자영수증
SOLAPI_KAKAO_TEMPLATE_RECEIPT=
# 결제 3개월 후 자동 발송되는 홍보 알림톡
SOLAPI_KAKAO_TEMPLATE_PROMO=

# 관리자 로그인(JWT) 서명 키. 운영 배포에서는 반드시 긴 랜덤 문자열로 고정해야 한다.
# 비워두면 로컬 개발 편의를 위해 서버가 매 부팅마다 임시 값을 자동 생성한다(재시작 시 기존 로그인 세션은 무효화됨).
JWT_SECRET=

# 최초 부팅 시 자동 생성되는 본사(hq_admin) 계정. 비워두면 admin@local + 무작위 비밀번호(콘솔에 1회 출력)로 생성된다.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# 토스플레이스 결제 웹훅(POST /api/webhooks/toss/payment) 서명 검증 키.
# 개발자센터에서 자체 등록이 안 되고 developer-support@tossplace.com에 문의해서 발급받아야 한다.
# 비워두면 서명 검증 없이(경고 로그만 남기고) 수신한다 — 운영 전 반드시 설정.
TOSS_WEBHOOK_SECRET=

# Cloud Scheduler가 프로모션 작업 endpoint를 호출할 때 사용하는 별도 공유 토큰.
# Cloud Run 서비스 전체를 공개 상태로 유지하면서 작업 endpoint만 인증하기 위해 사용한다.
PROMOTION_JOB_TOKEN=
